# ============================================================
#  个人咨询管家 — 环境变量
#  本地测试：复制为 .env
#  云端运行：配置在 GitHub 仓库 Settings → Secrets and variables → Actions
# ============================================================

# ---- 必填 ----
# DeepSeek API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Discord 频道 Webhook 地址
# Discord 频道 → 编辑频道 → 整合 → Webhook → 新建 Webhook → 复制 URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# ---- 选填 ----
# 模型与推理强度
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high

# 晚间复盘单独使用另一个 Webhook（留空则复用上面那个）
DISCORD_WEBHOOK_URL_EVENING=

# 推送时 @ 某人，例如 <@123456789012345678>
DISCORD_MENTION=

# 时区（决定 7:00 / 21:30 按哪个时间）
BRIEFING_TIMEZONE=Australia/Melbourne

# 称呼
USER_NAME=老李
